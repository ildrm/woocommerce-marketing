{
  "name": "wmos/woocommerce-marketing-os",
  "description": "Native WooCommerce marketing automation, consent and measurement",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {"php": ">=8.3", "ext-json": "*", "ext-sodium": "*"},
  "autoload": {"psr-4": {"Wmos\\": "src/"}},
  "autoload-dev": {"psr-4": {"Wmos\\Tests\\": "tests/"}},
  "require-dev": {"phpunit/phpunit": "^11.5", "phpstan/phpstan": "^2.1", "squizlabs/php_codesniffer": "^3.13", "wp-coding-standards/wpcs": "^3.1", "php-stubs/wordpress-stubs": "^6.9"},
  "config": {"sort-packages": true, "allow-plugins": {"dealerdirect/phpcodesniffer-composer-installer": true}},
  "scripts": {"test": "phpunit", "analyse": "phpstan analyse --memory-limit=1G"}
}
